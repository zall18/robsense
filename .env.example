# ==============================================================================
# RobSense Environment Configuration Template
# Salin file ini menjadi .env lalu sesuaikan dengan konfigurasi database & admin Anda.
# Perintah: cp .env.example .env
# ==============================================================================

# Database Connection (Supabase / PostgreSQL)
# DATABASE_URL: Menggunakan connection pooler (port 6543) dengan pgbouncer=true
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Koneksi langsung untuk migrasi Prisma (port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST].pooler.supabase.com:5432/postgres"

# Admin Authentication (Dashboard Puskesmas / Pemkot)
ADMIN_EMAIL="admin@robsense.id"
ADMIN_PASSWORD="admin123"
ADMIN_SESSION_SECRET="robsense_admin_session_secret_dsdc_2026_super_secure_key"

# Cron API Secret (Untuk sinkronisasi otomatis BMKG & background job)
CRON_SECRET="robsense_cron_secret_dsdc_2026"

# Opsional: Base URL aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"
