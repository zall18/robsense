generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LaporanWarga {
  id           String   @id @default(uuid())
  gejala       String   // "Demam" atau "Gatal-gatal"
  kecamatan    String
  latitude     Float?
  longitude    Float?
  ipAddress    String?  // Untuk rate limiting
  isVerified   Boolean  @default(false)
  kategori     String?  // Tinggi, Sedang, Rendah
  createdAt    DateTime @default(now())
}

model DataCuacaGenangan {
  id                 String   @id @default(uuid())
  kecamatan          String
  statusRisiko       String   // "Tinggi", "Sedang", "Rendah"
  riskScore          Int?     // Skor numerik 0-100
  weatherScore       Int?     // Skor Bahaya Cuaca (maks 25)
  seaScore           Int?     // Skor Bahaya Laut/Gelombang (maks 25)
  subsidenceScore    Int?     // Skor Kerentanan Amblesan (maks 20)
  vulnerabilityScore Int?     // Skor Kerentanan Air Tanah & Elevasi (maks 30)
  kondisiLaut        String?  // Kategori gelombang asli dari BMKG Maritim
  confidenceLevel    String?  // "Tinggi", "Sedang", "Rendah"
  ketinggianAir      Float?   // dalam cm
  trendStatus        String?  // "Meningkat", "Menurun", "Stabil"
  suhu               Float?
  kelembapan         Float?
  kecepatanAngin     Float?
  kondisi            String?
  timestamp          DateTime @default(now())
}

model ProfilKecamatan {
  id               String   @id @default(uuid())
  namaKecamatan    String   @unique
  tingkatRisiko    String   // Tinggi, Sedang, Rendah
  pendaftarEdukasi Int
  totalPopulasi    Int
  penggunaAirTanah Int      @default(0)
  updatedAt        DateTime @updatedAt
}
